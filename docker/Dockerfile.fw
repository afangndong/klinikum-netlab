FROM python:3.12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends nftables iproute2 \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir "fastapi>=0.110" "uvicorn>=0.29"
WORKDIR /app
COPY docker/fw_agent.py /app/fw_agent.py
COPY docker/fw-entry.sh /entry.sh
RUN chmod +x /entry.sh
ENTRYPOINT ["/entry.sh"]
CMD ["python", "/app/fw_agent.py"]
