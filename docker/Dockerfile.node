FROM python:3.12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends iproute2 iputils-ping curl netcat-openbsd wireguard-tools \
 && (apt-get install -y --no-install-recommends wireguard-go || echo "wireguard-go nicht verfügbar, VPN nutzt das Kernelmodul") \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir "fastapi>=0.110" "uvicorn>=0.29"
WORKDIR /app
COPY docker/node.py /app/node.py
COPY docker/node-entry.sh /entry.sh
RUN chmod +x /entry.sh
ENV WG_QUICK_USERSPACE_IMPLEMENTATION=wireguard-go
ENTRYPOINT ["/entry.sh"]
CMD ["python", "/app/node.py"]
